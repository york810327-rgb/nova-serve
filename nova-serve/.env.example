# ==========================================
# NovaServe - 环境变量配置示例
# ==========================================
# 使用说明：
#   1. 复制此文件并重命名为 .env
#   2. 根据实际环境修改以下配置项
#   3. 生产环境请务必将 DEBUG 设为 False
# ==========================================

# ---------- 应用基本信息 ----------
APP_NAME=NovaServe
APP_VERSION=1.0.0
DEBUG=True

# ---------- 服务配置 ----------
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# ---------- CORS 跨域配置 ----------
# 多个来源请以英文逗号分隔，例如: http://localhost:3000,http://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- 日志配置 ----------
LOG_LEVEL=INFO